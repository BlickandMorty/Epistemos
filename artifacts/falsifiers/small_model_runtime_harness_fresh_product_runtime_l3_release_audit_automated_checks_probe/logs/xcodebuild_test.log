        label: String
    ) async -> Bool {
        do {
            try await Task.sleep(for: duration)
            return true
        } catch is CancellationError {
            return false
        } catch {
            backgroundLog.error(
                "VaultSyncService: failed during \(label, privacy: .public): \(error.localizedDescription, privacy: .public)"
            )
            return false
        }
    }

