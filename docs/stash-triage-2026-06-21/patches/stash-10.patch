+    <tr><td>Lattice budget</td><td><code>Option&lt;LatticeBudget&gt;</code></td><td>WBO accounting if approximate</td></tr>
+    <tr><td>WRV status</td><td><code>{Wired, Reachable, Visible, Verified}</code></td><td>Honest status for product-facing surfaces</td></tr>
