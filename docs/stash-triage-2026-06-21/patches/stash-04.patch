+        let relativeCandidate = rootURL
+            .appendingPathComponent(rawPath)
+            .standardizedFileURL
+        if isDescendant(relativeCandidate, of: rootURL),
+           FileManager.default.fileExists(atPath: relativeCandidate.path) {
+            return relativeCandidate.path
+        }
