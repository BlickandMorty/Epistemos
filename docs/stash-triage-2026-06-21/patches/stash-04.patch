+          pointer-events: none;
+          color: var(--fg);
+          line-height: 1.45;
+          font: inherit;
+          tab-size: 4;
+          white-space: pre;
+        }
+
+        #highlight.wrap {
+          white-space: pre-wrap;
+          overflow-wrap: anywhere;
+        }
+
+        #highlight .line {
+          display: block;
+          min-height: 1.45em;
+        }
