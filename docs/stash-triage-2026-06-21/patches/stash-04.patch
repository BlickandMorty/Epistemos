+        sandboxPolicy: HTMLWorkspaceSandboxPolicy,
+        html: String,
+        css: String,
+        js: String,
+        dataJSON: String
+    ) {
+        self.workspaceID = workspaceID
+        self.title = title
+        self.contentHash = contentHash
+        self.sandboxPolicy = sandboxPolicy
+        self.html = html
+        self.css = css
+        self.js = js
+        self.dataJSON = dataJSON
