+            let writeIndex = base + delayWriteFrame
+            delayBufferLeft[writeIndex] = clampLiveSample(Float(dry.left) + feedbackLeft)
+            delayBufferRight[writeIndex] = clampLiveSample(Float(dry.right) + feedbackRight)
