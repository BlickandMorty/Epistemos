<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Phase-0 spike A: App Sandbox ON and NOTHING else. No JIT, no
	     unsigned-executable-memory, no disable-library-validation, no
	     network, no user-file access. Metal + embedded metallib must be
	     sufficient — that is the proof. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
